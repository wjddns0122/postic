# .env로 복사해서 값을 채운다. 값은 팀 안에서 직접 전달 (채팅·이슈·커밋에 쓰지 않기)
# cp .env.example .env

# Supabase 프로젝트 URL과 anon(공개) 키: 웹 빌드에 들어간다
VITE_SUPABASE_URL=https://hnnsiqgiibqgiyskdxyj.supabase.co
VITE_SUPABASE_ANON_KEY=

# 게이트 수신 키 (g1-ingest ?key=)
VITE_INGEST_KEY=

# 직원 대시보드(/admin) PIN: 빌드에 포함되지 않음 (VITE_ 접두사 없음). scripts/loadtest.mjs가 사용
STAFF_PIN=
